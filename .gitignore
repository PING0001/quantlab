.venv/
.env

# DuckDB database files
*.duckdb
*.duckdb.wal
*.duckdb.tmp

temp/
tmp/

# Log files
*.log

# Python cache
__pycache__/

# Cached predictions
data/predictions__*

# Generated forecast HTML reports
forecast_display/html/*/

# Generated trade signal JSON files
trade_signals/output/

# Editor/tool cache
.zcode/
.mimocode/
.workbuddy/

# macOS metadata
.DS_Store

