.venv/
.env

# DuckDB database files
*.duckdb
*.duckdb.wal
*.duckdb.tmp

temp/
tmp/

# Log files
*.log

# Python cache
__pycache__/

# Cached predictions
data/predictions__*

# Generated forecast HTML reports
forecast_display/html/*/

# Regenerable pool snapshot readable dumps (builder side-product)
pools/*.json

# Backtest runtime outputs (regenerable via backtest.run_lgb / fold_cv.py,
# 裁定 2026-08-27：回测产物一律不入库)
backtest/mainboard_microcap/
backtest/mainboard_all/

# Editor/tool cache
.zcode/
.mimocode/
.workbuddy/
.workbuddy-ai/

# macOS metadata
.DS_Store

# Generated LightGBM forecast HTML reports
forecast_display/html_lgb/*/

# Data backup directory
data/archive/

# Runtime lock file (auto-created by data/lock.py)
data/.pull.lock

# Runtime-generated reports (regenerated daily)
data/integrity_report.json
data/alpha_test_report.json

# fold predictions cache (regenerable via fold_cv.py)
data/folds/
.venv
